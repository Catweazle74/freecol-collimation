<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FreeCol.Ui.App"
             RequestedThemeVariant="Dark">
             <!-- Bewusst auf Dark gepinnt: die Hinweis-/Overlay-Farben im UI sind auf
                  dunklen Grund ausgelegt, und am Teleskop ist ein dunkles UI ohnehin
                  erwünscht (Nachtsicht). Theme-adaptive Ressourcen wären die saubere
                  Alternative, falls je ein Light-Modus gebraucht wird. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>